{
  "dataset_id": "day04_g10_research_group",
  "dataset_role": "group",
  "description": "Mười case do nhóm G10 thiết kế để đo routing, argument carry-over, confirmation boundary và tool source_audit mới.",
  "cases": [
    {
      "id": "G01_account_timeline_limit",
      "phase": "B",
      "query": "Lấy 2 tweet mới nhất của Sam Altman.",
      "failure_type": "wrong_arg_value",
      "expect": {
        "tool_calls": [
          {
            "name": "timeline",
            "args": {
              "screenname": "sama",
              "limit": 2
            }
          }
        ]
      },
      "metadata": {
        "what_it_tests": "Phân biệt timeline theo tài khoản và trích đúng limit.",
        "difficulty": "easy"
      }
    },
    {
      "id": "G02_social_topic_top",
      "phase": "B",
      "query": "Tìm các bài đăng top về Gemini trên Twitter.",
      "failure_type": "wrong_tool",
      "expect": {
        "tool_calls": [
          {
            "name": "social_search",
            "args": {
              "query": "Gemini",
              "search_type": "Top"
            }
          }
        ]
      },
      "metadata": {
        "what_it_tests": "Tìm social theo chủ đề và map từ top sang search_type=Top.",
        "difficulty": "easy"
      }
    },
    {
      "id": "G03_web_news_month",
      "phase": "B",
      "query": "Tìm tin an ninh mạng trong tháng này.",
      "failure_type": "wrong_arg_value",
      "expect": {
        "tool_calls": [
          {
            "name": "lookup",
            "args": {
              "query": "an ninh mạng",
              "topic": "news",
              "timeframe": "month"
            }
          }
        ]
      },
      "metadata": {
        "what_it_tests": "Map yêu cầu tin tức theo tháng sang lookup với đúng topic và timeframe.",
        "difficulty": "medium"
      }
    },
    {
      "id": "G04_missing_article_url",
      "phase": "B",
      "query": "Đọc và tóm tắt bài báo này cho tôi.",
      "failure_type": "missing_info",
      "expect": {
        "tool_calls": [
          {
            "name": "clarify",
            "args": {
              "response_type": "text"
            }
          }
        ]
      },
      "metadata": {
        "what_it_tests": "Không tự đoán URL khi user chưa cung cấp link.",
        "difficulty": "easy"
      }
    },
    {
      "id": "G05_source_diversity_audit",
      "phase": "B",
      "query": "Dùng source_audit kiểm tra độ đa dạng của hai nguồn https://openai.com/research/a và https://anthropic.com/research/b, yêu cầu tối thiểu 2 domain độc lập.",
      "failure_type": "wrong_tool",
      "expect": {
        "tool_calls": [
          {
            "name": "source_audit",
            "args": {
              "min_independent_sources": 2
            }
          }
        ]
      },
      "metadata": {
        "what_it_tests": "Routing vào tool mới source_audit khi items đã có và giữ đúng threshold.",
        "difficulty": "medium"
      }
    },
